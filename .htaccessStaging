AddType text/javascript .mjs

RewriteEngine On

# キャッシュ無効（検証用）
<FilesMatch "\.(webp|jpg|png|gif|css|js)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</FilesMatch>

# mjsのMIME設定
<IfModule mod_mime.c>
  AddType text/javascript .mjs
  AddType application/wasm .wasm
</IfModule>