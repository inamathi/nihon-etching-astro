---
// ============================================================
//  技術Q&A  /ja/knowledge/tech-faq/
//  配置場所: src/pages/[lang]/knowledge/tech-faq/index.astro
//  既存 shibo-design/index.astro の流儀に準拠（Base / PageHeader / Breadcrumb /
//  PageSectionHeading、slot="head" に FAQPage + TechArticle、Breadcrumbは二重注入しない）
// ============================================================

import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import Breadcrumb from "@/components/common/BreadCrumb.astro";
import PageSectionHeading from "@/components/ui/PageSectionHeading.astro";
import FaqAnswer from "@/components/knowledge/FaqAnswer.astro";
import { t, type Lang } from "@/locales/multilingual";
import {
  faqCategories,
  faqItems,
  faqBlocksToText,
} from "@/locales/faq/tech-faq";

export const getStaticPaths = () => [
  { params: { lang: "ja" } },
  { params: { lang: "en" } },
];

const { lang } = Astro.params as { lang: Lang };

const baseRoot = import.meta.env.BASE_URL.replace(/\/$/, "");
const basePath = `${baseRoot}/${lang}`;
const pageUrl = `https://nihon-etching.co.jp/${lang}/knowledge/tech-faq/`;

// { ja, en } を現在言語に解決（既存 node[lang] と同じフォールバック順）
const L = <T,>(n: { ja: T; en?: T }): T =>
  lang === "en" ? (n.en ?? n.ja) : n.ja;

// ── ページ固有のUI文言 ──
//   ※ 既存の meta / knowledge 名前空間に合わせて multilingual.ts へ移設可。
//     現状は未定義キーを踏まないよう、ここに ja/en 同居で置く
const ui = {
  pageTitle: { ja: "技術Q&A", en: "Technical Q&A" },
  lead: {
    ja: "金型のシボ加工・エッチングに関する技術的な質問と回答をまとめています。左の目次から探すか、キーワードで絞り込んでください。各質問は個別のURL（例 #q36）で共有できます。",
    en: "Technical questions and answers on mold texturing and etching. Browse by category on the left, or filter by keyword. Each question has its own shareable URL (e.g. #q36).",
  },
  filterPlaceholder: { ja: "キーワードで絞り込む", en: "Filter by keyword" },
  tocLabel: { ja: "カテゴリリスト", en: "Categories" },
  termsLabel: { ja: "用語", en: "Terms" },
  emptyMsg: {
    ja: "該当する質問がありません。別のキーワードで絞り込んでください。",
    en: "No matching questions. Try another keyword.",
  },
};

const seoTitle =
  lang === "ja"
    ? "技術Q&A｜シボ・エッチングの技術FAQ｜日本エッチング"
    : "Technical Q&A | Shibo & Etching FAQ | Nihon Etching";

// meta description（既存流儀では meta.description.* を使用。専用キー追加までは直書き）
const description =
  lang === "ja"
    ? "金型のシボ加工・エッチングに関する技術Q&A。図面指示、仕上げ処理とグロス、金型管理・運用まで、現場で問われる要点をまとめています。"
    : "Technical Q&A on mold texturing (shibo) and etching — drawing instructions, finishing and gloss, and mold management.";

// パンくず（最終要素は href なし）
const breadcrumbItems = [
  { label: t(lang, "nav.top"), href: `${basePath}/` },
  { label: t(lang, "nav.knowledge"), href: `${basePath}/knowledge/` },
  { label: L(ui.pageTitle) },
];

// 各設問を現在言語へ解決（qa[lang] ?? qa.en ?? qa.ja）
const items = faqItems.map((it) => ({
  id: it.id,
  cat: it.cat,
  terms: it.terms ?? [],
  c: lang === "en" ? (it.en ?? it.ja) : it.ja,
}));

// カテゴリ順に、設問を持つものだけを束ねる
const cats = faqCategories
  .map((cat) => ({ ...cat, items: items.filter((r) => r.cat === cat.id) }))
  .filter((cat) => cat.items.length > 0);

// ── JSON-LD: FAQPage（可視テキストと一致させる） ──
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  inLanguage: lang,
  mainEntity: items.map((r) => ({
    "@type": "Question",
    name: r.c.q,
    acceptedAnswer: { "@type": "Answer", text: faqBlocksToText(r.c.a) },
  })),
};

// ── JSON-LD: TechArticle（publisher @id は Base の Organization に合わせる） ──
const techArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${pageUrl}#article`,
  headline: L(ui.pageTitle),
  description,
  inLanguage: lang,
  url: pageUrl,
  publisher: { "@id": "https://nihon-etching.co.jp/#organization" },
  about: ["シボ加工", "金型表面処理", "エッチング", "品質管理"],
};
---

<Base
  lang={lang}
  title={seoTitle}
  description={description}
  ogImage="/ogp/ogp_technology.webp"
  breadcrumbItems={breadcrumbItems}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    slot="head"
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(techArticleSchema)}
    slot="head"
  />

  {/* KVは暫定で shibo-design のヘッダー画像を流用 */}
  <PageHeader
    eyebrowText="KNOWLEDGE"
    title={L(ui.pageTitle)}
    lead={L(ui.lead)}
    imageSrc={`${baseRoot}/images/pageHeader/pageheader-knowledge-tech-faq.webp`}
    imageAlt=""
  />

  <div class="l-container">
    <Breadcrumb
      ariaLabel={lang === "ja" ? "パンくずリスト" : "Breadcrumb"}
      items={breadcrumbItems}
    />

    <div class="p-techfaq" data-lang={lang}>
      {/* ── 左：操作パレット（固定ナビ＋フィルタ＋連動ハイライト） ── */}
      <aside class="p-techfaq__rail">
        <div class="p-techfaq__filter">
          <input
            id="faqFilter"
            type="search"
            autocomplete="off"
            placeholder={L(ui.filterPlaceholder)}
            aria-label={L(ui.filterPlaceholder)}
          />
          <button id="faqClear" type="button" aria-label="clear">×</button>
        </div>
        <p class="p-techfaq__count" id="faqCount"></p>

        <details class="p-techfaq__toc" id="faqToc" open>
          <summary>{L(ui.tocLabel)}</summary>
          <nav class="p-techfaq__nav" id="faqNav" aria-label={L(ui.tocLabel)}>
            {
              cats.map((cat) => (
                <div class="p-techfaq__group" data-cat={cat.id}>
                  <span class="p-techfaq__cat">
                    <span class="p-techfaq__mk">{cat.mark}</span>
                    {L(cat.label)}
                  </span>
                  {cat.items.map((it) => (
                    <a class="p-techfaq__link" href={`#${it.id}`}>
                      <span class="p-techfaq__qn">{it.id.toUpperCase()}</span>
                      <span class="p-techfaq__qt">{it.c.q}</span>
                    </a>
                  ))}
                </div>
              ))
            }
          </nav>
        </details>
      </aside>

      {/* ── 中央：回答本文 ── */}
      <div class="p-techfaq__main">
        {
          cats.map((cat) => (
            <section
              class="p-techfaq__cat-sec"
              id={`cat-${cat.id}`}
              data-cat={cat.id}
            >
              <div class="p-techfaq__catHead">
                <span class="p-techfaq__catMk">{cat.mark}</span>
                <h2 class="p-techfaq__catLabel">{cat.label[lang]}</h2>
              </div>
              {cat.items.map((it) => (
                <article class="p-techfaq__qa" id={it.id}>
                  <div class="p-techfaq__q">
                    <span class="p-techfaq__tag">{it.id.toUpperCase()}</span>
                    <h3>{it.c.q}</h3>
                  </div>
                  <div class="p-techfaq__a">
                    <FaqAnswer blocks={it.c.a} />
                  </div>
                  {it.terms.length > 0 && (
                    <div class="p-techfaq__terms">
                      <span class="p-techfaq__termsLabel">
                        {L(ui.termsLabel)}
                      </span>
                      {/* 用語集ページ実装後は <a href={`${basePath}/knowledge/glossary/#...`}> に差し替え */}
                      {it.terms.map((term) => (
                        <span class="p-techfaq__term">{term}</span>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </section>
          ))
        }
        <p class="p-techfaq__empty" id="faqEmpty">{L(ui.emptyMsg)}</p>
      </div>
    </div>
  </div>
</Base>

<style lang="scss">
  @use "@styles/var" as *;
  @use "@styles/mixin" as *;

  // 固定ヘッダー64px 分のオフセット
  .p-techfaq {
    --rail-top: 64px;
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: 1.5rem;
    align-items: start;
  }

  /* ── 左ペイン ── */
  .p-techfaq__rail {
    position: sticky;
    top: calc(var(--rail-top) + 1rem);
    align-self: start;
    max-height: calc(100dvh - var(--rail-top) - 2rem);
    overflow-y: auto;
    padding-right: 0.25rem;
    // Firefox / Chrome 121以降
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent;

    // Safari
    &::-webkit-scrollbar {
      width: 6px;
    }
    &::-webkit-scrollbar-track {
      background: transparent;
    }
    &::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 3px;
    }
  }

  .p-techfaq__filter {
    position: relative;
  }
  .p-techfaq__filter input {
    width: 100%;
    padding: 0.6rem 2rem 0.6rem 0.75rem;
    font: inherit;
    font-size: 0.9rem;
    color: inherit;
    background: rgba(#fff, 0.06);
    border: 1px solid rgba(#fff, 0.2);
    border-radius: 8px;
  }
  .p-techfaq__filter input:focus {
    outline: 2px solid $color-secondary;
    outline-offset: 1px;
    border-color: transparent;
  }
  .p-techfaq__filter button {
    position: absolute;
    right: 0.35rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1.5rem;
    height: 1.5rem;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: inherit;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.7;
    display: none;
  }
  .p-techfaq__filter button:hover {
    background: rgba(#fff, 0.1);
  }
  .p-techfaq__count {
    margin: 0.6rem 0.2rem 0;
    font-size: 0.75rem;
    opacity: 0.65;
  }

  .p-techfaq__toc summary {
    display: none;
  }
  .p-techfaq__nav {
    margin-top: 0.5rem;
  }
  .p-techfaq__group {
    margin-top: 1rem;
  }
  .p-techfaq__cat {
    display: block;
    padding: 0.35rem 0.5rem;
    font-size: var(--fs-r-s);
    font-weight: 700;
    letter-spacing: 0.03em;
    opacity: 0.8;
  }
  .p-techfaq__mk {
    display: inline-block;
    margin-right: 0.4rem;
    color: #fff;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: var(--fs-r-m);
    border-left: solid 4px $color-primary;
    padding-left: 10px;
  }
  .p-techfaq__link {
    display: grid;
    grid-template-columns: 2.1rem 1fr;
    align-items: baseline;
    gap: 8px;
    padding: 0.35rem 0.5rem;
    border-left: 2px solid transparent;
    border-radius: 0 6px 6px 0;
    text-decoration: none;
  }
  .p-techfaq__qn {
    font-size: 0.9rem;
    font-weight: var(--font-weight-heading);
    font-variant-numeric: tabular-nums;
    font-family: var(--font-accent);
    text-align: right;
    color: $color-accent;
  }
  .p-techfaq__qt {
    font-size: 0.8rem;
    line-height: 1.5;
    color: #fff;
  }
  .p-techfaq__link:hover {
    background: rgba(#fff, 0.05);
  }
  .p-techfaq__link.is-active {
    background: rgba($color-secondary, 0.18);
    border-left-color: $color-secondary;
  }
  .p-techfaq__link.is-active .p-techfaq__qt {
    font-weight: 700;
  }

  /* ── 中央ペイン ── */
  .p-techfaq__main {
    min-width: 0;
  }

  .p-techfaq__cat-sec {
    scroll-margin-top: calc(var(--rail-top) + 1rem);
  }
  .p-techfaq__catHead {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 2.5rem;
    border-bottom: solid 1px $color-primary;
  }
  .p-techfaq__cat-sec:first-child .p-techfaq__catHead {
    margin-top: 0;
  }
  .p-techfaq__catMk {
    flex: none;
    width: 1.7rem;
    height: 1.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: var(--fs-r-xxl);
  }
  .p-techfaq__catLabel {
    font-size: var(--fs-r-xl);
    color: #fff;
    margin: 10px 0;
  }

  .p-techfaq__qa {
    padding: 1.6rem 0;
    border-bottom: 1px solid rgba(#fff, 0.12);
    scroll-margin-top: calc(var(--rail-top) + 1rem);
  }
  .p-techfaq__q {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: baseline;
    margin-bottom: 0.9rem;
  }
  .p-techfaq__tag {
    display: grid;
    place-items: center;
    font-size: var(--fs-r-l);
    font-family: var(--font-accent);
    font-weight: var(--font-weight-body);
    color: #fff;
    font-variant-numeric: tabular-nums;
    background: $color-accent;
    border-radius: 4px;
    width: 40px;
    aspect-ratio: 1 / 1;
  }
  .p-techfaq__q h3 {
    margin: 0;
    font-size: var(--fs-r-l);
    line-height: 1.55;
    font-weight: 700;
  }
  .p-techfaq__a {
    font-size: var(--fs-r-m);
    font-weight: $fw-regular;
    text-align: justify;
  }

  /* 用語チップ */
  .p-techfaq__terms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
  }
  .p-techfaq__termsLabel {
    font-size: 0.7rem;
    opacity: 0.6;
    margin-right: 0.2rem;
  }
  .p-techfaq__term {
    font-size: 0.75rem;
    padding: 0.15rem 0.6rem;
    border-radius: 20px;
    background: rgba(#fff, 0.06);
    border: 1px solid rgba($color-gray-600, 1);
    opacity: 0.85;
  }

  .p-techfaq__empty {
    display: none;
    padding: 3rem 0.25rem;
    opacity: 0.7;
  }

  /* ── モバイル（既存の 768 ブレイクに合わせる） ── */
  @media (max-width: 768px) {
    .p-techfaq {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .p-techfaq__rail {
      position: static;
      max-height: none;
      overflow: visible;
    }
    .p-techfaq__filter {
      position: sticky;
      top: var(--rail-top);
      z-index: 5;
      padding: 0 0;
      background: rgba(0, 0, 0, 0.5);
      -webkit-backdrop-filter: blur(6px); // Safari用
      backdrop-filter: blur(6px);
    }
    .p-techfaq__toc summary {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      list-style: none;
      cursor: pointer;
      padding: 0.7rem 0.5rem;
      font-weight: 700;
      position: relative;
      padding-left: 1.5rem;
    }
    .p-techfaq__toc summary::-webkit-details-marker {
      display: none;
    }
    .p-techfaq__toc summary::before {
      content: "";
      position: absolute;
      top: 18px;
      left: 6px;
      width: 0;
      height: 0;
      border-style: solid;
      border-width: 6px 0 6px 10px; // 上 右 下 左
      border-color: transparent transparent transparent $color-accent;
    }
    .p-techfaq__toc[open] summary::before {
      transform: rotate(90deg);
      border-color: transparent transparent transparent $color-gray-700;
    }
    .p-techfaq__cat-sec,
    .p-techfaq__qa {
      scroll-margin-top: calc(var(--rail-top) + 3.5rem);
    }
  }
</style>

<script>
  // ── 技術Q&A クライアント挙動：フィルタ / 連動ハイライト / モバイル目次 ──
  const root = document.querySelector<HTMLElement>(".p-techfaq");
  if (root) {
    const lang = root.dataset.lang === "en" ? "en" : "ja";
    const input = document.getElementById(
      "faqFilter",
    ) as HTMLInputElement | null;
    const clear = document.getElementById("faqClear");
    const countEl = document.getElementById("faqCount");
    const emptyEl = document.getElementById("faqEmpty");
    const toc = document.getElementById("faqToc") as HTMLDetailsElement | null;

    const qas = Array.from(
      root.querySelectorAll<HTMLElement>(".p-techfaq__qa"),
    );
    const secs = Array.from(
      root.querySelectorAll<HTMLElement>(".p-techfaq__cat-sec"),
    );
    const groups = Array.from(
      root.querySelectorAll<HTMLElement>(".p-techfaq__group"),
    );
    const TOTAL = qas.length;

    const linkById: Record<string, HTMLElement> = {};
    root
      .querySelectorAll<HTMLAnchorElement>(".p-techfaq__link")
      .forEach((a) => {
        const id = a.getAttribute("href")!.slice(1);
        linkById[id] = a;
      });
    qas.forEach(
      (qa) => ((qa as any)._txt = (qa.textContent || "").toLowerCase()),
    );

    const fmtCount = (shown: number) => {
      if (shown === TOTAL)
        return lang === "en" ? `${TOTAL} questions` : `全 ${TOTAL} 問`;
      return lang === "en"
        ? `Showing ${shown} of ${TOTAL}`
        : `${shown} / ${TOTAL} 問を表示`;
    };
    if (countEl) countEl.textContent = fmtCount(TOTAL);

    const applyFilter = () => {
      const q = (input?.value || "").trim().toLowerCase();
      if (clear) (clear as HTMLElement).style.display = q ? "block" : "none";
      let shown = 0;
      qas.forEach((qa) => {
        const hit = !q || (qa as any)._txt.indexOf(q) !== -1;
        qa.hidden = !hit;
        if (hit) shown++;
        const link = linkById[qa.id];
        if (link) link.hidden = !hit;
      });
      secs.forEach((sec) => {
        sec.hidden =
          sec.querySelectorAll(".p-techfaq__qa:not([hidden])").length === 0;
      });
      groups.forEach((g) => {
        g.hidden =
          g.querySelectorAll(".p-techfaq__link:not([hidden])").length === 0;
      });
      if (emptyEl)
        (emptyEl as HTMLElement).style.display = shown === 0 ? "block" : "none";
      if (countEl) countEl.textContent = fmtCount(shown);
    };

    input?.addEventListener("input", applyFilter);
    clear?.addEventListener("click", () => {
      if (input) input.value = "";
      applyFilter();
      input?.focus();
    });

    // ── 連動ハイライト（PCのみ。固定ヘッダー64px を考慮） ──
    const desktop = window.matchMedia("(min-width: 769px)");
    let io: IntersectionObserver | null = null;
    const setActive = (id: string) => {
      root
        .querySelectorAll(".p-techfaq__link.is-active")
        .forEach((a) => a.classList.remove("is-active"));
      linkById[id]?.classList.add("is-active");
    };
    const startIO = () => {
      if (io || !desktop.matches) return;
      io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) setActive((e.target as HTMLElement).id);
          });
        },
        { rootMargin: "-64px 0px -70% 0px", threshold: 0 },
      );
      qas.forEach((qa) => io!.observe(qa));
    };
    const stopIO = () => {
      io?.disconnect();
      io = null;
      root
        .querySelectorAll(".p-techfaq__link.is-active")
        .forEach((a) => a.classList.remove("is-active"));
    };
    const syncMode = () => {
      if (desktop.matches) {
        if (toc) toc.open = true;
        startIO();
      } else {
        stopIO();
      }
    };
    desktop.addEventListener("change", syncMode);
    syncMode();

    // モバイル：目次内リンクをタップしたら目次を畳む
    document.getElementById("faqNav")?.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest(".p-techfaq__link");
      if (a && toc && !desktop.matches) toc.open = false;
    });
  }
</script>

<script>
  const TARGET_ID = "q7"; // Q7要素の実際のidに合わせてください

  const nav = performance.getEntriesByType("navigation")[0] as
    PerformanceNavigationTiming | undefined;
  const isFreshVisit = nav?.type === "navigate";

  if (isFreshVisit && !location.hash) {
    document.getElementById(TARGET_ID)?.scrollIntoView({ block: "start" });
  }
</script>
