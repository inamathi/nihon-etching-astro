---
// ============================================================
//  シボ設計ガイド  /ja/shibo-design/
//  配置場所: src/pages/[lang]/shibo-design/index.astro
//  （既存の [lang]/technology/shibo/index.astro と同じ構成）
// ============================================================

import Base from "../../../layouts/Base.astro"; // TODO: 既存ページと同じ import パスか確認

// 既存パターンに合わせ params のみ返す。EN訳が未完のため今は ja のみ生成。
// EN公開時に { params: { lang: "en" } } を追加する。
export const getStaticPaths = () => [{ params: { lang: "ja" } }];

// lang は params から取得（既存 shibo と同じ流儀）
const { lang } = Astro.params;

// BASE_URL（/ne-staging/ 等）込みの内部リンク用パス
const baseRoot = import.meta.env.BASE_URL.replace(/\/$/, "");
const basePath = `${baseRoot}/${lang}`;

// スキーマ用の本番絶対URL（canonical。baseRoot は含めない）
const pageUrl = `https://nihon-etching.co.jp/${lang}/shibo-design/`;

// --- SEO メタ ---------------------------------------------------
const title =
  "シボ設計ガイド｜抜き勾配・番手の選び方とウェルド／ヒケ対策｜日本エッチング";
const description =
  "シボは3D形状を作り込む前に決める設計判断です。抜き勾配との関係、番手の選び方、ウェルドライン・ヒケ・キズ対策を、シボ加工専門の日本エッチングが解説します。";

// --- パンくず（Base.astro 側で BreadcrumbList を生成する既存パターンに渡す） ---
const breadcrumb = [
  { name: "トップ", href: `${basePath}/` },
  { name: "シボ設計ガイド" }, // 現在ページなので href なし
];

// --- 課題 → 解決（外観） ----------------------------------------
const issues = [
  {
    problem: "塗装をやめたいが安っぽく見える",
    solution: "塗装と同じ凹凸構造を成形面で再現し、塗装調の外観を得る",
  },
  {
    problem: "ウェルドラインが見える",
    solution:
      "パターンによる視覚的なカムフラージュに加え、樹脂流動の改善により発生自体を抑える",
  },
  {
    problem: "肉厚変化部のヒケが目立つ",
    solution: "拡散反射により、映り込みの歪みとして知覚されにくくする",
  },
  {
    problem: "キズが目立つ",
    solution: "凸部を滑らかにして露出面積を減らし、傷の起点と視認性を下げる",
  },
  {
    problem: "指紋・皮脂が目立つ",
    solution: "凸部の接触面積が小さいため、付着が目立ちにくい",
  },
];

// --- FAQ（コピー確定版 / 結論先頭） ------------------------------
const faqs = [
  {
    q: "シボを深くすれば、ウェルドはより隠れますか。",
    a: "深さと隠蔽力は比例しません。日本エッチングの工法は、同じ深さの従来梨地と比べて目立ちにくくなることを確認しています。深さを増やすより、工法を変えるほうが効果的です。深くすれば、その分だけ必要な抜き勾配も増えます。",
  },
  {
    q: "同じ番手なら、樹脂が変わっても同じ見え方になりますか。",
    a: "なりません。樹脂の種類・色・流動性・金型温度などによって、光沢や質感は変わります。実際に使用する材料でのサンプル成形をおすすめします。",
  },
  {
    q: "再生材を使う予定です。シボで外観の課題を吸収できますか。",
    a: "一定の効果が見込めます。ウェルドをカムフラージュする原理は、異物や色ムラに対しても同じように働きます。ただし材料のばらつきの程度によりますので、実材料での確認をお願いします。",
  },
  {
    q: "触感シリーズを使いたいのですが、抜き勾配が足りません。",
    a: "深さを下げれば、必要な勾配も下がります。光沢を保ったまま質感を付けたい場合は、抜き勾配1〜1.5°で使える Enjoy Touch をご検討ください。",
  },
  {
    q: "HN-DS と STEP・N-TONE・TFC、どちらを選べばよいですか。",
    a: "キズと汚れに対しては、いずれも効果があります。塗装調の外観やウェルド対策が目的であれば STEP・N-TONE・TFC、成形時のかじりや深物形状への適用が目的であれば HN-DS をおすすめします。",
  },
  {
    q: "金型を海外に移管する予定があります。",
    a: "海外工場でも日本と同品質の加工が可能です。海外提携工場ではメンテナンスにも対応しています。移管先を早めにお知らせいただければ、体制をご案内します。",
  },
  {
    q: "3次元曲面が多い形状です。",
    aHtml: `エッチングは平面のマスキングを前提とするため、曲面ではパターンに伸びが生じることがあります。<a href="${basePath}/technology/laser/">5軸レーザー加工（HN-LTシリーズ）</a>であれば CAD データを基準に加工でき、曲面追従や部位ごとの調整が可能です。`,
    a: "エッチングは平面のマスキングを前提とするため、曲面ではパターンに伸びが生じることがあります。5軸レーザー加工（HN-LTシリーズ）であれば CAD データを基準に加工でき、曲面追従や部位ごとの調整が可能です。",
  },
  {
    q: "8µm という浅いシボで、ウェルドやヒケは隠せますか。",
    a: "隠せません。ウェルド隠蔽には20µm以上、ヒケには30µm以上が一般的な目安です。8µmを維持するなら、リブ厚を本体の50〜60%（肉厚2mmなら1.0〜1.2mm）に抑え、ゲート位置でウェルドを非意匠面へ逃がすなど、設計側で完結させる必要があります。",
  },
];

// --- JSON-LD: FAQPage（今回の新規スキーマ） ---------------------
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.aHtml ?? f.a },
  })),
};

// --- JSON-LD: TechArticle（任意。主張を機械可読化） --------------
// publisher の @id は Base.astro の Organization の実値に合わせる
const techArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${pageUrl}#article`,
  headline: "シボ設計ガイド｜抜き勾配・番手の選び方とウェルド／ヒケ対策",
  description,
  inLanguage: "ja",
  url: pageUrl,
  publisher: { "@id": "https://nihon-etching.co.jp/#organization" },
  about: ["シボ加工", "金型表面処理", "抜き勾配", "テクスチャリング"],
};
---

<Base
  title={title}
  description={description}
  breadcrumb={breadcrumb}
  lang={lang}
>
  {
    /* 新規スキーマは slot="head" で注入（BreadcrumbList は Base 側の既存パターンに任せ、二重注入しない） */
  }
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(techArticleSchema)}
    />
  </Fragment>

  <article class="shibo-design">
    <p class="eyebrow">GUIDE</p>
    <h1>シボ設計ガイド</h1>

    {/* 引用されやすい“結論先頭”のリード（AI Overview の抽出対象） */}
    <p class="lead">
      シボは、意匠を仕上げてから選ぶ「表面処理」ではなく、<strong
        >3D形状を作り込む前に決める設計判断</strong
      >です。ここでは、抜き勾配との関係、番手の選び方、ウェルドライン・ヒケ・キズへの対策を、シボ加工専門の日本エッチングの視点で解説します。
    </p>

    {/* ── セクション1：思想（差別化の核） ── */}
    <section aria-labelledby="why-first">
      <h2 id="why-first">なぜシボは「最初」に決めるのか</h2>
      <p>
        シボの選定は、3D形状を作り込む前に済ませておくべき設計判断です。多くの現場では、意匠が固まったあと、量産直前に番手を選びます。しかし実際には、シボは部品形状に制約を課します。
      </p>
      <p>
        シボが深くなるほど、金型から抜くために必要な<strong>抜き勾配</strong
        >は大きくなります。意匠面の傾斜が足りなければ、望んだシボは入りません。後から決めると、勾配不足による意匠変更か、シボの妥協かの<strong
          >二択</strong
        >になります。だからシボは「最後」ではなく「最初」に決めます。
      </p>
    </section>

    {/* ── セクション2：課題→解決テーブル ── */}
    <section aria-labelledby="solve">
      <h2 id="solve">シボで解決できる課題</h2>
      <p>
        シボは外観の演出だけの技術ではありません。ここでは外観に関わる代表的な課題と、シボによる解決のしかたを整理します。
      </p>
      <table class="issue-table">
        <thead>
          <tr>
            <th scope="col">課題</th>
            <th scope="col">シボによる解決</th>
          </tr>
        </thead>
        <tbody>
          {
            issues.map((row) => (
              <tr>
                <th scope="row">{row.problem}</th>
                <td>{row.solution}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    {/* ── セクション3：FAQ ── */}
    <section aria-labelledby="faq">
      <h2 id="faq">よくあるご質問</h2>
      <dl class="faq">
        {
          faqs.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              {f.aHtml ? <dd set:html={f.aHtml} /> : <dd>{f.a}</dd>}
            </div>
          ))
        }
      </dl>
    </section>

    {/* ── 関連導線（内部リンクのハブ化） ── */}
    <nav class="related" aria-label="関連ページ">
      <a href={`${basePath}/technology/shibo/`}>シボ加工（パターン一覧）</a>
      <a href={`${basePath}/technology/laser/`}>5軸レーザー彫刻</a>
      <a href={`${basePath}/contact/`}>サンプル・お見積もりのご相談</a>
    </nav>
  </article>
</Base>

<style>
  /* 既存のデザイントークンがあればそちらに寄せてください。最小限のベースのみ。 */
  .shibo-design {
    max-width: 820px;
    margin-inline: auto;
  }
  .eyebrow {
    letter-spacing: 0.15em;
    font-size: 0.8rem;
    opacity: 0.6;
    margin: 0;
  }
  .lead {
    font-size: 1.1rem;
    line-height: 1.9;
  }
  .shibo-design section {
    margin-block: 3rem;
  }
  .issue-table {
    width: 100%;
    border-collapse: collapse;
  }
  .issue-table th,
  .issue-table td {
    text-align: left;
    vertical-align: top;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid #e5e5e5;
  }
  .issue-table thead th {
    border-bottom-width: 2px;
    white-space: nowrap;
  }
  .issue-table tbody th[scope="row"] {
    font-weight: 600;
    width: 34%;
  }
  .faq-item {
    padding: 1.1rem 0;
    border-bottom: 1px solid #e5e5e5;
  }
  .faq dt {
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .faq dd {
    margin: 0;
    line-height: 1.9;
  }
  .related {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
  }
</style>
